@model PresseMots.Models.Story

@foreach (var item in @Model.StoryTags)
{
    <span class="badge badge-secondary">
        @item.Tag.Name    &nbsp;&nbsp;
        <a asp-action="Delete" asp-controller="StoryTags" asp-route-Id="@item.Id" class="badge badge-danger badge-pill" CODE À COMPLÉTER >&nbsp;×&nbsp;</a>
    </span>

} 